# --- LLM ensemble (OpenAI-compatible, comma separated for several models) ---
# OpenRouter: https://openrouter.ai/api/v1  DeepSeek: https://api.deepseek.com/v1  Moonshot: https://api.moonshot.ai/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Comma separated model list = ensemble, e.g. deepseek/deepseek-chat,moonshotai/kimi-k2
LLM_MODELS=deepseek/deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=45
AI_INSTRUCTIONS=

# --- Clef (Cloudflare decision model, self-hosted via SGLang) ---
# Leave empty to disable. Start: sglang serve --model-path Cloudflare/clef-flash --port 30000
CLEF_BASE_URL=
# e.g. Cloudflare/clef-flash
CLEF_MODEL=
CLEF_TIMEOUT=10

# --- Jev (TypeSafe hosted decision model) ---
# Get a key at https://console.typesafe.ai/keys ; leave JEV_API_KEY empty to disable
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_BASE_URL=https://api.typesafe.ai
JEV_TIMEOUT=10

# --- Strategy ---
ASSETS=BTC
# YES trades the model direction, NO trades the opposite
OBEY_MODEL=YES
# Ask models when this many minutes remain
TIME_DELAY=15
# Min ensemble edge over market price to enter
MIN_EDGE=0.06
# Edge cap to skip near-certain mispriced-looking quotes
MAX_EDGE=0.35
# Fractional Kelly, 0 = fixed size
KELLY_FRACTION=0.25
ORDER_SIZE=300
# USD cap on simultaneously open cost
MAX_EXPOSURE=1000
# Extra daily PnL limits (0 disables). Shadow strategies are also halted by these.
MAX_DAILY_PROFIT=400
MAX_DAILY_LOSS=-200

# --- Ensemble weights (vol model, LLM, Clef, Jev) ---
W_VOL=0.45
W_LLM=0.4
W_CLEF=0.15
W_JEV=0.15

# --- Paper realism ---
SIMULATE_FEES=YES
# order book depth levels used to estimate average fill
BOOK_DEPTH=10
POLL_SECONDS=2
# events with impact score >= threshold widen the edge requirement
EVENT_EDGE_BONUS=0.03

# --- Data & logging ---
TRADES_FILE=trades.jsonl
DB_PATH=data/bot.db
RECORDER=YES
SNAPSHOT_SECONDS=8
MEMORY_DAYS=7

# Shadow-mode comparison strategies, comma separated
# llm_solo, clef_solo, jev_solo, vol_only, always_up, always_down, momentum
SHADOW_STRATEGIES=llm_solo,vol_only,always_up,momentum
